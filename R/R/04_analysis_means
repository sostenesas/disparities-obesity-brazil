source("R/R/00_config")

df <- readRDS(here("data","derived","pns_2013_2019_analytic.rds"))

des <- svydesign(
  id = ~psu,
  strata = ~strata,
  weights = ~weight_norm,  # use ~weight se preferir
  data = df,
  nest = TRUE
) %>% srvyr::as_survey_design()

# >>> Substitui o seu aggregate(): agora é média ponderada + SE/IC <<<
mean_imc_age_sex <- des %>%
  group_by(ano, fx_idade, sexo) %>%
  summarize(imc_mean = survey_mean(IMC, vartype = c("se","ci"), na.rm = TRUE), .groups="drop")

write_csv(mean_imc_age_sex, here("outputs","tables","mean_imc_age_sex.csv"))

p1 <- ggplot(mean_imc_age_sex, aes(x = fx_idade, y = imc_mean, group = interaction(ano, sexo))) +
  geom_point() +
  geom_line() +
  facet_wrap(~sexo) +
  labs(x="Faixa etária", y="IMC médio (ponderado)", title="IMC médio por idade e sexo (PNS 2013/2019)") +
  theme(axis.text.x = element_text(angle=45, hjust=1))

ggsave(here("outputs","figures","fig_imc_mean_age_sex.png"), p1, width=9, height=5, dpi=300)
message("(ok) Médias (ponderadas) prontas.")